<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Connot_Change_Status_from_Approved</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISCHANGED(Status__c),
  OR (TEXT(PRIORVALUE(Status__c)) = &quot;Approved&quot;,              TEXT(PRIORVALUE(Status__c)) = &quot;Cancelled&quot; )
)</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>Cannot Change the status from Approved and Cancelled. For cancelled create a new Credit Record</errorMessage>
</ValidationRule>
