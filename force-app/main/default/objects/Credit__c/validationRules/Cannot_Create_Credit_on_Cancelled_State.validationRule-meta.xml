<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cannot_Create_Credit_on_Cancelled_State</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISNEW() , ISPICKVAL(Status__c, &quot;Cancelled&quot;) )</errorConditionFormula>
    <errorMessage>Cannot Create Record in Cancelled State</errorMessage>
</ValidationRule>
